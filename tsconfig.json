{
	"compilerOptions": {
		// Dirs
		"rootDir": "./src",
		"outDir": "./dist",

		// Env settings
		"module": "nodenext",
		"target": "es2022",
		"lib": ["ES2022"],
		"types": ["node"],

		// Outputs
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		// Typecheck
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		// ESM & Tooling compatibility
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	},
	"include": ["src/**/*"]
}
